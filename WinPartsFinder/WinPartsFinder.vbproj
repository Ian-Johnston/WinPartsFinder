      <DependentUpon>MainForm.vb</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Forms\SettingsForm.resx">
      <DependentUpon>SettingsForm.vb</DependentUpon>
    </EmbeddedResource>
    <!-- Cartoon on the About window -->
    <EmbeddedResource Include="Resources\AboutCartoon.png">
      <LogicalName>WinPartsFinder.AboutCartoon.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <None Include="app.manifest" />
    <Content Include="WinPartsFinder.ico" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.VisualBasic.targets" />
</Project>
