      <DependentUpon>ImagePopupForm.vb</DependentUpon>
    </Compile>
    <Compile Include="Forms\BomForm.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="Forms\BomForm.Designer.vb">
      <DependentUpon>BomForm.vb</DependentUpon>
    </Compile>
    <Compile Include="Infrastructure\AppSettings.vb" />
    <Compile Include="Infrastructure\ExchangeRates.vb" />
    <Compile Include="Infrastructure\ImageCache.vb" />
