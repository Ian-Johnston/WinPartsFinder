    </Compile>
    <Compile Include="Forms\AboutForm.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="Forms\AboutForm.Designer.vb">
      <DependentUpon>AboutForm.vb</DependentUpon>
    </Compile>
    <Compile Include="Forms\HelpForm.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="Forms\HelpForm.Designer.vb">
      <DependentUpon>HelpForm.vb</DependentUpon>
    </Compile>
    <Compile Include="Forms\AdvancedSearchForm.vb">
      <SubType>Form</SubType>
    </Compile>
